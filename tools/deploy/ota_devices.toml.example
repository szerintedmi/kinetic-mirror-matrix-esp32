# OTA Deployment Device Configuration
# Copy to ota_devices.toml and customize with your device IPs

[devices]
# List of device IP addresses for OTA deployment
ips = [
    "192.168.1.100",
    "192.168.1.101",
]

[ota]
# OTA password - must match OTA_PASSWORD in secrets.h
password = "kinetic-mirror-ota"
